go 1.26.0

// Development resolution: the server module, the client module and
// the weft checkout beside this repository. The go.mod files require
// weft at its published version; the workspace builds against the
// checkout instead. Until the client module is tagged, the server's
// go.mod requires it at the placeholder pseudo-version; the replace
// line resolves that version to ./client (go.mod files never commit a
// replace). A module the workspace uses still needs its placeholder
// replaced: the module graph reads the required version's go.mod.
use (
	.
	./client
	../weft
	../weft/core
)

replace (
	github.com/weftbase/weftbase/client v0.0.0-00010101000000-000000000000 => ./client
)

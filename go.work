go 1.26.0

// Development resolution: the server module and the client module.
// Both go.mod files require weft at its published version, and the
// server's requires the client at its published tag (the module proxy
// serves them), so a fresh clone builds with nothing beside it; in the
// workspace, ./client is used in place of the tagged client.
//
// To build against a weft checkout beside this repository instead, add
// it locally (do not commit it): go work use ../weft ../weft/core
use (
	.
	./client
)
